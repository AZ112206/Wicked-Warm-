# Wicked Warm - environment template (safe to commit)
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env   (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)

# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud project number (optional)
GOOGLE_PROJECT_NUMBER=your_project_number_here

# OPTIONAL. EIA API key for live residential energy prices.
# Free + instant from https://www.eia.gov/opendata/register.php
# Leave blank to use built-in placeholder prices (forecast still works).
EIA_API_KEY=
